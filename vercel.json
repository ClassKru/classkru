{
  "rewrites": [
    {"source":"/mini-lab-v2","destination":"/v2.html"},
    {"source":"/api/v2/(.*)","destination":"/api/media-studio?action=v2&path=$1"},
    {"source":"/api/dev/media-models","destination":"/api/dev/media?resource=models"},
    {"source":"/api/dev/v2-media","destination":"/api/dev/media?resource=v2"},
    {"source":"/api/exports/:document","destination":"/api/exports?document=:document"}
  ],
  "functions": {
    "api/media-studio/index.js":{"maxDuration":300,"includeFiles":"node_modules/@sparticuz/chromium/bin/**"},
    "api/dev/v2-media.js":{"maxDuration":300}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/developer/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/dev/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
