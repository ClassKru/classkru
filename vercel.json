{
  "redirects": [
    {"source":"/","destination":"/home.html","permanent":false}
  ],
  "rewrites": [
    {"source":"/api/ai/navigation","destination":"/api/media-studio?action=classkru-ai&path=navigation"},
    {"source":"/api/ai/brief-versions","destination":"/api/media-studio?action=classkru-ai&path=brief-versions"},
    {"source":"/api/ai/model-settings","destination":"/api/media-studio?action=classkru-ai&path=model-settings"},
    {"source":"/api/auth/username","destination":"/api/auth/line/start?mode=username-signup"},
    {"source":"/api/auth/line/link/start","destination":"/api/auth/line/start?mode=link"},
    {"source":"/api/dev/login","destination":"/api/dev/auth?action=login"},
    {"source":"/api/dev/logout","destination":"/api/dev/auth?action=logout"},
    {"source":"/api/dev/session","destination":"/api/dev/auth?action=session"},
    {"source":"/mini-lab-v2","destination":"/v2.html"},
    {"source":"/api/v2/(.*)","destination":"/api/media-studio?action=v2&path=$1"},
    {"source":"/mini-lab-v5","destination":"/v5.html"},
    {"source":"/api/v5/(.*)","destination":"/api/media-studio?action=v5&path=$1"},
    {"source":"/vendor/three.module.js","destination":"/api/media-studio?action=v5&path=three"},
    {"source":"/vendor/three.core.js","destination":"/api/media-studio?action=v5&path=three-core"},
    {"source":"/api/exports/:document","destination":"/api/exports?document=:document"}
  ],
  "functions": {
    "api/media-studio/index.js":{"maxDuration":300,"includeFiles":"{node_modules/@sparticuz/chromium/bin/**,brief-versions/**,classkru ai chat/briefs/**,node_modules/three/build/three.module.js,node_modules/three/build/three.core.js}"}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/developer/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/dev/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
